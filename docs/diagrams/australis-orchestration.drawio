        <mxCell id="le7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6b4c85;" edge="1" parent="1" source="dWf" target="dAct"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6b4c85;" edge="1" parent="1" source="dAct" target="dWkr"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6b4c85;dashed=1;" edge="1" parent="1" source="dAct" target="mOrc"><mxGeometry relative="1" as="geometry" /></mxCell>
