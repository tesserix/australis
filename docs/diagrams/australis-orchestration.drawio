<mxfile host="app.diagrams.net" modified="2026-09-05T02:00:00.000Z" agent="Australis Docs" version="31.4.2" compressed="false">
  <diagram id="orch-ctx" name="01 System Context"><mxGraphModel dx="1480" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1480" pageHeight="900" math="0" shadow="0"><root>
    <mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Global supervisor and orchestrator — deterministic flow, bounded model judgement" style="text;html=1;strokeColor=none;fillColor=none;fontSize=25;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1250" height="38" as="geometry"/></mxCell><mxCell id="sub" value="The orchestrator routes and enforces limits. Workers produce untrusted output. The supervisor alone makes model-backed verdicts." style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;fontColor=#5E6C84;" vertex="1" parent="1"><mxGeometry x="40" y="67" width="1250" height="26" as="geometry"/></mxCell>
    <mxCell id="call" value="PRODUCT CALLERS" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#F1FBF5;strokeColor=#63A97B;fontColor=#1B5E36;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="290" height="570" as="geometry"/></mxCell><mxCell id="svc" value="ORCHESTRATOR SERVICE" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#F4F8FF;strokeColor=#7AA7E8;fontColor=#174A8B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="370" y="130" width="390" height="570" as="geometry"/></mxCell><mxCell id="agents" value="AGENT EXECUTION" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#FDECEC;strokeColor=#D35D5D;fontColor=#8F3B38;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="130" width="360" height="570" as="geometry"/></mxCell><mxCell id="plat" value="SHARED PLATFORM" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#FFF8E8;strokeColor=#D9A441;fontColor=#704D00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1200" y="130" width="240" height="570" as="geometry"/></mxCell>
    <mxCell id="p1" value="&lt;b&gt;Product APIs / BFFs&lt;/b&gt;&lt;br&gt;Kora · Mark8ly · HomeChef" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#63A97B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="80" y="220" width="210" height="80" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;Australis / ADK&lt;/b&gt;&lt;br&gt;agent or workflow caller" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#63A97B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="80" y="380" width="210" height="75" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;Operators&lt;/b&gt;&lt;br&gt;status and readiness" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#63A97B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="80" y="535" width="210" height="75" as="geometry"/></mxCell>
    <mxCell id="edge" value="&lt;b&gt;Authenticated API edge&lt;/b&gt;&lt;br&gt;status · delegate · pipeline&lt;br&gt;request ID + stable errors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA7E8;fontSize=14;" vertex="1" parent="1"><mxGeometry x="415" y="205" width="300" height="95" as="geometry"/></mxCell><mxCell id="orch" value="&lt;b&gt;Deterministic orchestrator&lt;/b&gt;&lt;br&gt;roster routing · ledger · deadline&lt;br&gt;step ceiling · no model calls" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA7E8;fontSize=14;" vertex="1" parent="1"><mxGeometry x="415" y="360" width="300" height="100" as="geometry"/></mxCell><mxCell id="report" value="&lt;b&gt;Total report&lt;/b&gt;&lt;br&gt;every completed, failed, refused or rejected step" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FF;strokeColor=#7AA7E8;fontSize=14;" vertex="1" parent="1"><mxGeometry x="415" y="535" width="300" height="85" as="geometry"/></mxCell>
    <mxCell id="worker" value="&lt;b&gt;One named worker&lt;/b&gt;&lt;br&gt;A2A message/send&lt;br&gt;output treated as untrusted data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D35D5D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="845" y="260" width="270" height="95" as="geometry"/></mxCell><mxCell id="sup" value="&lt;b&gt;Supervisor&lt;/b&gt;&lt;br&gt;PII + injection guards&lt;br&gt;approve · amend · reject" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D9;strokeColor=#D6A03D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="845" y="455" width="270" height="95" as="geometry"/></mxCell>
    <mxCell id="reg" value="&lt;b&gt;Registry&lt;/b&gt;&lt;br&gt;agent roster&lt;br&gt;catalog only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9A441;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1230" y="245" width="180" height="85" as="geometry"/></mxCell><mxCell id="gw" value="&lt;b&gt;AgentGateway&lt;/b&gt;&lt;br&gt;approved model path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9A441;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1230" y="465" width="180" height="75" as="geometry"/></mxCell><mxCell id="note" value="New worker = reviewed roster entry and policy, not an orchestrator code path. Depth remains one: workers cannot delegate to other workers." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D35D5D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="280" y="760" width="920" height="70" as="geometry"/></mxCell>
    <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#3E8C5A;" edge="1" parent="1" source="p1" target="edge"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#4C7FC0;" edge="1" parent="1" source="edge" target="orch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#D35D5D;" edge="1" parent="1" source="orch" target="worker"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#D6A03D;" edge="1" parent="1" source="worker" target="sup"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#4C7FC0;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="sup" target="report"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#B57B12;" edge="1" parent="1" source="reg" target="worker"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#B57B12;" edge="1" parent="1" source="sup" target="gw"><mxGeometry relative="1" as="geometry"/></mxCell>
  </root></mxGraphModel></diagram>
  <diagram id="orch-flows" name="02 Task Shapes"><mxGraphModel dx="1480" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1480" pageHeight="900" math="0" shadow="0"><root>
    <mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="User workflows — one JSON contract, three task shapes" style="text;html=1;strokeColor=none;fillColor=none;fontSize=25;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1100" height="38" as="geometry"/></mxCell><mxCell id="sub" value="Unknown fields are rejected. Every call has a monotonic deadline and a complete report." style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;fontColor=#5E6C84;" vertex="1" parent="1"><mxGeometry x="40" y="67" width="1000" height="26" as="geometry"/></mxCell>
    <mxCell id="a" value="STATUS" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#F1FBF5;strokeColor=#63A97B;fontColor=#1B5E36;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="430" height="620" as="geometry"/></mxCell><mxCell id="b" value="DELEGATE" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#F4F8FF;strokeColor=#7AA7E8;fontColor=#174A8B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="525" y="130" width="430" height="620" as="geometry"/></mxCell><mxCell id="c" value="PIPELINE" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#FDECEC;strokeColor=#D35D5D;fontColor=#8F3B38;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1010" y="130" width="430" height="620" as="geometry"/></mxCell>
    <mxCell id="a1" value="{ task: status }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#63A97B;fontFamily=Courier New;fontSize=14;" vertex="1" parent="1"><mxGeometry x="85" y="205" width="340" height="60" as="geometry"/></mxCell><mxCell id="a2" value="Probe every roster worker&lt;br&gt;bounded timeout · no delegation ledger" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#63A97B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="85" y="330" width="340" height="80" as="geometry"/></mxCell><mxCell id="a3" value="Per-worker ok/failure report&lt;br&gt;&lt;b&gt;never supervised&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F6EA;strokeColor=#58A36E;fontSize=14;" vertex="1" parent="1"><mxGeometry x="85" y="480" width="340" height="80" as="geometry"/></mxCell>
    <mxCell id="b1" value="{ task: delegate, agent, prompt }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA7E8;fontFamily=Courier New;fontSize=13;" vertex="1" parent="1"><mxGeometry x="570" y="205" width="340" height="60" as="geometry"/></mxCell><mxCell id="b2" value="Normalize to one-step pipeline&lt;br&gt;carry_forward=false · supervise=true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA7E8;fontSize=14;" vertex="1" parent="1"><mxGeometry x="570" y="330" width="340" height="80" as="geometry"/></mxCell><mxCell id="b3" value="Worker answer → supervisor verdict&lt;br&gt;approved/amended output or rejection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FF;strokeColor=#7AA7E8;fontSize=14;" vertex="1" parent="1"><mxGeometry x="570" y="480" width="340" height="80" as="geometry"/></mxCell>
    <mxCell id="c1" value="{ task: pipeline, steps: [...] }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D35D5D;fontFamily=Courier New;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1055" y="205" width="340" height="60" as="geometry"/></mxCell><mxCell id="c2" value="Up to 12 declared steps&lt;br&gt;each worker output quarantined as data&lt;br&gt;supervisor verdict before carry-forward" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D35D5D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1055" y="330" width="340" height="100" as="geometry"/></mxCell><mxCell id="c3" value="Total OrchestrationReport&lt;br&gt;completed · failed · refused · rejected&lt;br&gt;final approved output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D35D5D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1055" y="500" width="340" height="95" as="geometry"/></mxCell><mxCell id="note" value="The caller never infers missing steps: every requested step receives a terminal state and machine-readable reason." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D9;strokeColor=#D6A03D;fontSize=15;" vertex="1" parent="1"><mxGeometry x="280" y="790" width="920" height="65" as="geometry"/></mxCell>
    <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#3E8C5A;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#3E8C5A;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C7FC0;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C7FC0;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D35D5D;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D35D5D;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell>
  </root></mxGraphModel></diagram>
  <diagram id="orch-handoff" name="03 Supervised Handoff"><mxGraphModel dx="1480" dy="950" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1480" pageHeight="950" math="0" shadow="0"><root>
    <mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Supervised handoff — untrusted content never controls flow" style="text;html=1;strokeColor=none;fillColor=none;fontSize=25;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1100" height="38" as="geometry"/></mxCell><mxCell id="sub" value="Trusted context is labelled separately from worker output. The deterministic orchestrator alone decides routing." style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;fontColor=#5E6C84;" vertex="1" parent="1"><mxGeometry x="40" y="67" width="1150" height="26" as="geometry"/></mxCell>
    <mxCell id="a" value="ORCHESTRATOR" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#F4F8FF;strokeColor=#7AA7E8;fontColor=#174A8B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="430" height="520" as="geometry"/></mxCell><mxCell id="b" value="WORKER — UNTRUSTED OUTPUT" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#FDECEC;strokeColor=#D35D5D;fontColor=#8F3B38;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="525" y="130" width="430" height="520" as="geometry"/></mxCell><mxCell id="c" value="SUPERVISOR" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#FFF8E8;strokeColor=#D9A441;fontColor=#704D00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1010" y="130" width="430" height="520" as="geometry"/></mxCell>
    <mxCell id="a1" value="&lt;b&gt;1 · Admit step&lt;/b&gt;&lt;br&gt;claim ledger · monotonic deadline · step ceiling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA7E8;fontSize=14;" vertex="1" parent="1"><mxGeometry x="85" y="205" width="340" height="80" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;2 · Build envelope&lt;/b&gt;&lt;br&gt;trusted context + step prompt&lt;br&gt;previous output labelled untrusted data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA7E8;fontSize=14;" vertex="1" parent="1"><mxGeometry x="85" y="350" width="340" height="95" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;3 · A2A message/send&lt;/b&gt;&lt;br&gt;one named worker · closed response envelope" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D35D5D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="570" y="245" width="340" height="85" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;4 · Extract reply&lt;/b&gt;&lt;br&gt;state + artifacts[].parts[].text only&lt;br&gt;ignore every other field" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D35D5D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="570" y="405" width="340" height="95" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b&gt;5 · Judge&lt;/b&gt;&lt;br&gt;task + labelled worker text&lt;br&gt;PII and injection guardrails" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9A441;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1055" y="265" width="340" height="95" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;6 · Verdict&lt;/b&gt;&lt;br&gt;decision · confidence · summary · issues" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D9;strokeColor=#D6A03D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1055" y="435" width="340" height="85" as="geometry"/></mxCell>
    <mxCell id="ok" value="&lt;b&gt;APPROVE&lt;/b&gt;&lt;br&gt;carry worker answer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F6EA;strokeColor=#58A36E;fontSize=14;" vertex="1" parent="1"><mxGeometry x="160" y="735" width="300" height="80" as="geometry"/></mxCell><mxCell id="amend" value="&lt;b&gt;AMEND&lt;/b&gt;&lt;br&gt;carry supervisor summary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D9;strokeColor=#D6A03D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="590" y="735" width="300" height="80" as="geometry"/></mxCell><mxCell id="reject" value="&lt;b&gt;REJECT / FAILURE&lt;/b&gt;&lt;br&gt;stop; report; nothing crosses" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D35D5D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1020" y="735" width="300" height="80" as="geometry"/></mxCell>
    <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C7FC0;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#D35D5D;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a2" target="b1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="397"/><mxPoint x="500" y="287"/></Array></mxGeometry></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D35D5D;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#D6A03D;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b2" target="c1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="452"/><mxPoint x="980" y="312"/></Array></mxGeometry></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D6A03D;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#58A36E;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c2" target="ok"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1123" y="670"/><mxPoint x="310" y="670"/></Array></mxGeometry></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D6A03D;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c2" target="amend"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1225" y="695"/><mxPoint x="740" y="695"/></Array></mxGeometry></mxCell><mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D35D5D;exitX=0.8;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c2" target="reject"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1327" y="715"/><mxPoint x="1170" y="715"/></Array></mxGeometry></mxCell>
  </root></mxGraphModel></diagram>
  <diagram id="orch-lld" name="04 Modules and Durable Path"><mxGraphModel dx="1480" dy="950" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1480" pageHeight="950" math="0" shadow="0"><root>
    <mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Module map — dependencies point inward and the durable path reuses one service" style="text;html=1;strokeColor=none;fillColor=none;fontSize=25;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1300" height="38" as="geometry"/></mxCell><mxCell id="sub" value="API imports services; services import I/O adapters and contracts. Nothing imports the API layer." style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;fontColor=#5E6C84;" vertex="1" parent="1"><mxGeometry x="40" y="67" width="1050" height="26" as="geometry"/></mxCell>
    <mxCell id="edge" value="EDGE" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#F4F8FF;strokeColor=#7AA7E8;fontColor=#174A8B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="760" height="180" as="geometry"/></mxCell><mxCell id="svc" value="SERVICES" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#FFF8E8;strokeColor=#D9A441;fontColor=#704D00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="760" height="210" as="geometry"/></mxCell><mxCell id="io" value="I/O ADAPTERS" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#FDECEC;strokeColor=#D35D5D;fontColor=#8F3B38;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="760" height="210" as="geometry"/></mxCell><mxCell id="dur" value="OPTIONAL DURABLE PATH" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#F7F4FF;strokeColor=#9B7ED0;fontColor=#52357E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="860" y="130" width="580" height="680" as="geometry"/></mxCell>
