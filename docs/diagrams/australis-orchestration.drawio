  </diagram>

  <diagram name="04 LLD — Modules and Durable Path" id="orch-lld">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t1" value="LLD — module map, contracts, and the durable path" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="32" as="geometry" /></mxCell>
        <mxCell id="t2" value="dependencies point strictly downward · api imports services · services import workers/gateway/definitions · nothing imports api" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1600" height="20" as="geometry" /></mxCell>

        <mxCell id="gEdge" value="Edge layer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;fontStyle=1;fontColor=#3b5c8a;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="760" height="170" as="geometry" /></mxCell>
        <mxCell id="mApi" value="api.py&#10;&#10;bearer auth (hmac.compare_digest)&#10;error taxonomy: 401 / 404 / 422 / 502&#10;A2A request/response models" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=6;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="70" y="135" width="280" height="110" as="geometry" /></mxCell>
        <mxCell id="mMain" value="main.py&#10;composition root&#10;(uvicorn)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="135" width="180" height="80" as="geometry" /></mxCell>
        <mxCell id="mCfg" value="config.py&#10;Settings (ORCHESTRATOR_)&#10;WorkerEndpoint roster" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="590" y="135" width="180" height="80" as="geometry" /></mxCell>

        <mxCell id="gSvc" value="Service layer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d79b00;dashed=1;verticalAlign=top;fontStyle=1;fontColor=#a06800;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="760" height="230" as="geometry" /></mxCell>
        <mxCell id="mOrc" value="orchestration.py&#10;&#10;OrchestrationTask.parse (extra=forbid)&#10;OrchestratorService: status / delegate / pipeline&#10;_RunState: ledger + deadline&#10;StepReport / OrchestrationReport" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=6;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="70" y="335" width="330" height="130" as="geometry" /></mxCell>
        <mxCell id="mSup" value="supervision.py&#10;&#10;SupervisorService.supervise&#10;AgentRunner + PIIGuard + InjectionGuard&#10;completed Verdict or SupervisionFailedError" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=6;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="430" y="335" width="340" height="130" as="geometry" /></mxCell>

        <mxCell id="gIO" value="I/O layer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;verticalAlign=top;fontStyle=1;fontColor=#8f3b38;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="760" height="180" as="geometry" /></mxCell>
        <mxCell id="mWrk" value="workers.py&#10;&#10;A2AWorkerClient.send&#10;closed reason codes: http_NNN,&#10;invalid_json, invalid_envelope,&#10;jsonrpc_error_*, missing_result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;spacingTop=6;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="70" y="595" width="330" height="120" as="geometry" /></mxCell>
        <mxCell id="mGw" value="gateway.py&#10;&#10;OpenAICompatibleProvider → Solo gateway&#10;x-tesserix-capability / context-kind headers&#10;secret handed over by name, nothing else" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;spacingTop=6;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="430" y="595" width="340" height="120" as="geometry" /></mxCell>

        <mxCell id="gDur" value="Durable path — Temporal (optional)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;verticalAlign=top;fontStyle=1;fontColor=#6b4c85;" vertex="1" parent="1"><mxGeometry x="860" y="100" width="480" height="640" as="geometry" /></mxCell>
        <mxCell id="dCli" value="caller starts&#10;OrchestrationWorkflow&#10;input: {raw_task, tenant} only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="890" y="140" width="260" height="70" as="geometry" /></mxCell>
        <mxCell id="dWf" value="durable.py — @workflow.defn&#10;&#10;one activity call, RetryPolicy(max 3)&#10;non-retryable: UnsupportedTaskError" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=6;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="890" y="245" width="330" height="90" as="geometry" /></mxCell>
        <mxCell id="dAct" value="@activity.defn run_orchestration&#10;&#10;delegates to the same&#10;OrchestratorService as the HTTP edge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=6;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="890" y="370" width="330" height="90" as="geometry" /></mxCell>
        <mxCell id="dWkr" value="worker.py — python -m orchestrator_agent.worker&#10;&#10;queue: orchestrations&#10;ORCHESTRATOR_TEMPORAL_ADDRESS empty → disabled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=6;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="890" y="495" width="380" height="90" as="geometry" /></mxCell>
        <mxCell id="dNote" value="Deliberately one activity per run, not per step: per-step replay needs the ADK's journalled workflow stores, and whole-run retry keeps worker answers and credentials out of Temporal history. Secrets live only in worker process state." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890" y="615" width="420" height="95" as="geometry" /></mxCell>

        <mxCell id="le1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="mApi" target="mOrc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="mApi" target="mSup"><mxGeometry relative="1" as="geometry" /></mxCell>
