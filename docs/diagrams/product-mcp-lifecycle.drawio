        <mxCell id="ttitle" value="Evidence ladder — every gate proves a different boundary" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=26;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="t1"><mxGeometry x="40" y="25" width="950" height="40" as="geometry"/></mxCell>
        <mxCell id="tsub" value="Run cheap deterministic tests first; production promotion requires the authenticated ADK journey and digest-bound eval evidence." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontColor=#5E6C84;" vertex="1" parent="t1"><mxGeometry x="40" y="68" width="1100" height="30" as="geometry"/></mxCell>

        <mxCell id="tg1" value="&lt;b&gt;A · Local&lt;/b&gt;&lt;br&gt;tool contract&lt;br&gt;boundaries&lt;br&gt;cross-tenant denial" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FF;strokeColor=#5B8FD8;fontSize=14;" vertex="1" parent="t1"><mxGeometry x="45" y="170" width="175" height="115" as="geometry"/></mxCell>
        <mxCell id="tg2" value="&lt;b&gt;B · Conformance&lt;/b&gt;&lt;br&gt;discovery + call&lt;br&gt;faults + lifecycle&lt;br&gt;51 security cases" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FF;strokeColor=#5B8FD8;fontSize=14;" vertex="1" parent="t1"><mxGeometry x="245" y="170" width="175" height="115" as="geometry"/></mxCell>
        <mxCell id="tg3" value="&lt;b&gt;C · Artifact&lt;/b&gt;&lt;br&gt;digest + SBOM&lt;br&gt;secret scan&lt;br&gt;schema fingerprint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FF;strokeColor=#5B8FD8;fontSize=14;" vertex="1" parent="t1"><mxGeometry x="445" y="170" width="175" height="115" as="geometry"/></mxCell>
        <mxCell id="tg4" value="&lt;b&gt;D · Mesh&lt;/b&gt;&lt;br&gt;Ready + strict mTLS&lt;br&gt;SPIFFE allow&lt;br&gt;untrusted 403" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D9;strokeColor=#D6A03D;fontSize=14;" vertex="1" parent="t1"><mxGeometry x="645" y="170" width="175" height="115" as="geometry"/></mxCell>
        <mxCell id="tg5" value="&lt;b&gt;E · Activation&lt;/b&gt;&lt;br&gt;Registry exact fetch&lt;br&gt;route accepted&lt;br&gt;stateless probe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D9;strokeColor=#D6A03D;fontSize=14;" vertex="1" parent="t1"><mxGeometry x="845" y="170" width="175" height="115" as="geometry"/></mxCell>
        <mxCell id="tg6" value="&lt;b&gt;F · Agent eval&lt;/b&gt;&lt;br&gt;select + no-select&lt;br&gt;ground + cite&lt;br&gt;safe degradation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEE7FA;strokeColor=#8D6BC1;fontSize=14;" vertex="1" parent="t1"><mxGeometry x="1045" y="170" width="175" height="115" as="geometry"/></mxCell>
        <mxCell id="tg7" value="&lt;b&gt;G · Canary&lt;/b&gt;&lt;br&gt;named consumer&lt;br&gt;SLO comparison&lt;br&gt;automatic rollback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F6EA;strokeColor=#58A36E;fontSize=14;" vertex="1" parent="t1"><mxGeometry x="1245" y="170" width="175" height="115" as="geometry"/></mxCell>

        <mxCell id="scores" value="&lt;b&gt;Eight promotion scores&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F4FF;strokeColor=#8D6BC1;fontSize=18;fontStyle=1;" vertex="1" parent="t1"><mxGeometry x="80" y="400" width="260" height="65" as="geometry"/></mxCell>
        <mxCell id="scorelist" value="Correctness · Schema conformance · Secret leakage · Tenant isolation&lt;br&gt;Authorization denial · Idempotency · Latency · Availability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8D6BC1;fontSize=15;align=left;spacingLeft=16;" vertex="1" parent="t1"><mxGeometry x="380" y="380" width="1000" height="105" as="geometry"/></mxCell>

        <mxCell id="trace" value="&lt;b&gt;One W3C trace lineage&lt;/b&gt;&lt;br&gt;agent.run → tool.select → mcp.client.request → mcp.server.request → authorization → execution → product API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8F3;strokeColor=#C76B98;fontSize=16;" vertex="1" parent="t1"><mxGeometry x="80" y="560" width="1300" height="85" as="geometry"/></mxCell>
