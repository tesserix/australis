  <diagram id="lifecycle" name="2 - Release lifecycle">
    <mxGraphModel dx="1480" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="l0"/>
        <mxCell id="l1" parent="l0"/>
        <mxCell id="ltitle" value="Connector lifecycle — source to useful production call" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=26;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="l1"><mxGeometry x="40" y="25" width="900" height="40" as="geometry"/></mxCell>
        <mxCell id="lsub" value="A deployment is not complete until a named agent discovers, selects, invokes, grounds, and cites the tool." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontColor=#5E6C84;" vertex="1" parent="l1"><mxGeometry x="40" y="68" width="1050" height="30" as="geometry"/></mxCell>

        <mxCell id="step1" value="&lt;b&gt;1. Author&lt;/b&gt;&lt;br&gt;product repo&lt;br&gt;closed read schemas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FF;strokeColor=#5B8FD8;fontSize=15;" vertex="1" parent="l1"><mxGeometry x="55" y="160" width="210" height="100" as="geometry"/></mxCell>
        <mxCell id="step2" value="&lt;b&gt;2. Test&lt;/b&gt;&lt;br&gt;unit + cross-tenant&lt;br&gt;conformance + security" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FF;strokeColor=#5B8FD8;fontSize=15;" vertex="1" parent="l1"><mxGeometry x="335" y="160" width="210" height="100" as="geometry"/></mxCell>
        <mxCell id="step3" value="&lt;b&gt;3. Build&lt;/b&gt;&lt;br&gt;independent image&lt;br&gt;digest + SBOM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FF;strokeColor=#5B8FD8;fontSize=15;" vertex="1" parent="l1"><mxGeometry x="615" y="160" width="210" height="100" as="geometry"/></mxCell>
        <mxCell id="step4" value="&lt;b&gt;4. Stage&lt;/b&gt;&lt;br&gt;Argo + Ambient&lt;br&gt;SPIFFE negative test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FF;strokeColor=#5B8FD8;fontSize=15;" vertex="1" parent="l1"><mxGeometry x="895" y="160" width="210" height="100" as="geometry"/></mxCell>
        <mxCell id="step5" value="&lt;b&gt;5. Publish&lt;/b&gt;&lt;br&gt;Registry seed&lt;br&gt;reseedNonce" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D9;strokeColor=#D6A03D;fontSize=15;" vertex="1" parent="l1"><mxGeometry x="1175" y="160" width="210" height="100" as="geometry"/></mxCell>

        <mxCell id="step6" value="&lt;b&gt;6. Reconcile&lt;/b&gt;&lt;br&gt;Backend + HTTPRoute&lt;br&gt;credential policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D9;strokeColor=#D6A03D;fontSize=15;" vertex="1" parent="l1"><mxGeometry x="1175" y="420" width="210" height="100" as="geometry"/></mxCell>
        <mxCell id="step7" value="&lt;b&gt;7. Probe&lt;/b&gt;&lt;br&gt;tools/list + harmless call&lt;br&gt;deny invalid identity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D9;strokeColor=#D6A03D;fontSize=15;" vertex="1" parent="l1"><mxGeometry x="895" y="420" width="210" height="100" as="geometry"/></mxCell>
        <mxCell id="step8" value="&lt;b&gt;8. Evaluate&lt;/b&gt;&lt;br&gt;ADK + real model policy&lt;br&gt;eight digest-bound scores" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEE7FA;strokeColor=#8D6BC1;fontSize=15;" vertex="1" parent="l1"><mxGeometry x="615" y="420" width="210" height="100" as="geometry"/></mxCell>
        <mxCell id="step9" value="&lt;b&gt;9. Canary&lt;/b&gt;&lt;br&gt;named first consumer&lt;br&gt;independent Kargo freight" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F6EA;strokeColor=#58A36E;fontSize=15;" vertex="1" parent="l1"><mxGeometry x="335" y="420" width="210" height="100" as="geometry"/></mxCell>
        <mxCell id="step10" value="&lt;b&gt;10. Operate&lt;/b&gt;&lt;br&gt;SLO + traces + alerts&lt;br&gt;deprecate → observe → retire" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F6EA;strokeColor=#58A36E;fontSize=15;" vertex="1" parent="l1"><mxGeometry x="55" y="420" width="210" height="100" as="geometry"/></mxCell>

        <mxCell id="gate" value="&lt;b&gt;Production consumer gate&lt;/b&gt;&lt;br&gt;Named owner · exact Registry/image/schema pins · role plan · HTTP eval passes · rollback ready" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8F3;strokeColor=#C76B98;strokeWidth=2;fontSize=16;" vertex="1" parent="l1"><mxGeometry x="270" y="650" width="940" height="100" as="geometry"/></mxCell>
        <mxCell id="note" value="No consumer? Stop after staging: internal record, gatewayExport=false, no production Kargo subscription." style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=14;fontStyle=2;fontColor=#7A3E61;" vertex="1" parent="l1"><mxGeometry x="270" y="770" width="940" height="35" as="geometry"/></mxCell>

        <mxCell id="le1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#5B8FD8;" edge="1" parent="l1" source="step1" target="step2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#5B8FD8;" edge="1" parent="l1" source="step2" target="step3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#5B8FD8;" edge="1" parent="l1" source="step3" target="step4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#B57B12;" edge="1" parent="l1" source="step4" target="step5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#B57B12;" edge="1" parent="l1" source="step5" target="step6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1410" y="210"/><mxPoint x="1410" y="470"/></Array></mxGeometry></mxCell>
        <mxCell id="le6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#B57B12;" edge="1" parent="l1" source="step6" target="step7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#8D6BC1;" edge="1" parent="l1" source="step7" target="step8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#58A36E;" edge="1" parent="l1" source="step8" target="step9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#58A36E;" edge="1" parent="l1" source="step9" target="step10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le10" value="admit" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;dashed=1;strokeColor=#C76B98;" edge="1" parent="l1" source="step8" target="gate"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="security" name="3 - Identity and secrets">
    <mxGraphModel dx="1480" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="s0"/>
        <mxCell id="s1" parent="s0"/>
        <mxCell id="stitle" value="Four trust crossings — authenticate and authorize every hop" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=26;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="s1"><mxGeometry x="40" y="25" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="sthreat" value="Assets: tenant catalog, identities, credentials and tool results. Threats: unauthenticated callers, another tenant, a compromised workload or dependency, and accidental secret leakage." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D79B43;fontSize=14;align=left;spacingLeft=14;" vertex="1" parent="s1"><mxGeometry x="40" y="85" width="1400" height="60" as="geometry"/></mxCell>

        <mxCell id="zone1" value="1 · AGENT IDENTITY" style="swimlane;html=1;horizontal=1;startSize=34;rounded=1;fillColor=#F4F8FF;strokeColor=#7AA7E8;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="40" y="190" width="310" height="420" as="geometry"/></mxCell>
        <mxCell id="zone2" value="2 · WORKLOAD IDENTITY" style="swimlane;html=1;horizontal=1;startSize=34;rounded=1;fillColor=#FFF8E8;strokeColor=#D9A441;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="400" y="190" width="310" height="420" as="geometry"/></mxCell>
        <mxCell id="zone3" value="3 · TOOL AUTHORIZATION" style="swimlane;html=1;horizontal=1;startSize=34;rounded=1;fillColor=#F7F4FF;strokeColor=#9B7ED0;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="760" y="190" width="310" height="420" as="geometry"/></mxCell>
        <mxCell id="zone4" value="4 · DATA AUTHORIZATION" style="swimlane;html=1;horizontal=1;startSize=34;rounded=1;fillColor=#F1FBF5;strokeColor=#63A97B;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="1120" y="190" width="320" height="420" as="geometry"/></mxCell>

        <mxCell id="jwt" value="&lt;b&gt;Zitadel JWT&lt;/b&gt;&lt;br&gt;signature · alg · issuer&lt;br&gt;audience · expiry · role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA7E8;fontSize=14;" vertex="1" parent="s1"><mxGeometry x="80" y="260" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="role" value="Today: agentgateway.mcp&lt;br&gt;Target: mcp:tenant:server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FF;strokeColor=#7AA7E8;fontSize=13;" vertex="1" parent="s1"><mxGeometry x="80" y="420" width="230" height="70" as="geometry"/></mxCell>

        <mxCell id="spiffe" value="&lt;b&gt;Ambient mTLS&lt;/b&gt;&lt;br&gt;SPIFFE principal&lt;br&gt;agentgateway-mcp SA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9A441;fontSize=14;" vertex="1" parent="s1"><mxGeometry x="440" y="260" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="waypoint" value="Waypoint Service policy&lt;br&gt;+ workload policy&lt;br&gt;+ NetworkPolicy / HBONE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D9;strokeColor=#D9A441;fontSize=13;" vertex="1" parent="s1"><mxGeometry x="440" y="420" width="230" height="82" as="geometry"/></mxCell>

        <mxCell id="mcpkey" value="&lt;b&gt;X-MCP-Key&lt;/b&gt;&lt;br&gt;injected by gateway&lt;br&gt;never exposed to agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B7ED0;fontSize=14;" vertex="1" parent="s1"><mxGeometry x="800" y="260" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="toolauth" value="Runtime re-checks&lt;br&gt;tool allowlist · arguments&lt;br&gt;private data: signed caller scopes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEE7FA;strokeColor=#9B7ED0;fontSize=13;" vertex="1" parent="s1"><mxGeometry x="800" y="420" width="230" height="82" as="geometry"/></mxCell>

        <mxCell id="storekey" value="&lt;b&gt;X-Storefront-Key&lt;/b&gt;&lt;br&gt;separate product secret&lt;br&gt;connector → API only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#63A97B;fontSize=14;" vertex="1" parent="s1"><mxGeometry x="1165" y="260" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="objectauth" value="Product API re-checks&lt;br&gt;tenant · user · storefront&lt;br&gt;object and row scope" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F6EA;strokeColor=#63A97B;fontSize=13;" vertex="1" parent="s1"><mxGeometry x="1165" y="420" width="230" height="82" as="geometry"/></mxCell>

        <mxCell id="deny" value="&lt;b&gt;Default deny at every boundary&lt;/b&gt;&lt;br&gt;Missing or invalid authority fails before the handler. Unknown and forbidden objects use a non-disclosing response. No token, identity, URL, prompt, payload, or secret enters logs, metrics, traces, or eval reports." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D35D5D;strokeWidth=2;fontSize=15;align=left;spacingLeft=16;" vertex="1" parent="s1"><mxGeometry x="150" y="690" width="1180" height="100" as="geometry"/></mxCell>

        <mxCell id="se1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#5B8FD8;" edge="1" parent="s1" source="jwt" target="spiffe"><mxGeometry relative="1" as="geometry"/></mxCell>
