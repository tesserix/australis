        <mxCell id="se3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#7B5CB5;" edge="1" parent="s1" source="mcpkey" target="storekey"><mxGeometry relative="1" as="geometry"/></mxCell>
