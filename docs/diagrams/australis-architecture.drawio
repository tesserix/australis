  </root></mxGraphModel></diagram>
  <diagram id="lifecycle" name="02 Connector Lifecycle"><mxGraphModel dx="1480" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1480" pageHeight="900" math="0" shadow="0"><root>
    <mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Connector lifecycle — ownership changes, contract does not" style="text;html=1;strokeColor=none;fillColor=none;fontSize=25;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1100" height="38" as="geometry"/></mxCell><mxCell id="sub" value="Product builds and operates. Platform publishes and routes. Australis pins, evaluates and consumes." style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;fontColor=#5E6C84;" vertex="1" parent="1"><mxGeometry x="40" y="67" width="1100" height="26" as="geometry"/></mxCell>
    <mxCell id="p1" value="PRODUCT REPOSITORY + CI" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#F1FBF5;strokeColor=#63A97B;fontColor=#1B5E36;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="430" height="560" as="geometry"/></mxCell><mxCell id="p2" value="AGENTIC PLATFORM" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#FFF8E8;strokeColor=#D9A441;fontColor=#704D00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="525" y="130" width="430" height="560" as="geometry"/></mxCell><mxCell id="p3" value="AUSTRALIS / ADK" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#F7F4FF;strokeColor=#9B7ED0;fontColor=#52357E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1010" y="130" width="430" height="560" as="geometry"/></mxCell>
    <mxCell id="a1" value="&lt;b&gt;1 · Author&lt;/b&gt;&lt;br&gt;bounded tools · closed schemas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#63A97B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="85" y="205" width="340" height="72" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;2 · Test&lt;/b&gt;&lt;br&gt;unit · tenancy · conformance · security" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#63A97B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="85" y="335" width="340" height="72" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b&gt;3 · Build and stage&lt;/b&gt;&lt;br&gt;image digest · SBOM · Ambient denial test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#63A97B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="85" y="465" width="340" height="78" as="geometry"/></mxCell>
    <mxCell id="b1" value="&lt;b&gt;4 · Publish&lt;/b&gt;&lt;br&gt;Registry seed + credentialRef" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9A441;fontSize=14;" vertex="1" parent="1"><mxGeometry x="570" y="205" width="340" height="72" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;5 · Reconcile&lt;/b&gt;&lt;br&gt;Backend · HTTPRoute · credential policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9A441;fontSize=14;" vertex="1" parent="1"><mxGeometry x="570" y="335" width="340" height="72" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;6 · Probe&lt;/b&gt;&lt;br&gt;authenticated list/call + denial tests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9A441;fontSize=14;" vertex="1" parent="1"><mxGeometry x="570" y="465" width="340" height="78" as="geometry"/></mxCell>
    <mxCell id="c1" value="&lt;b&gt;7 · Pin&lt;/b&gt;&lt;br&gt;Registry · image · schema · tools" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B7ED0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1055" y="205" width="340" height="72" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;8 · Evaluate&lt;/b&gt;&lt;br&gt;selection · grounding · citations · eight scores" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B7ED0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1055" y="335" width="340" height="72" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;9 · Canary and operate&lt;/b&gt;&lt;br&gt;named consumer · SLO · rollback · retire" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B7ED0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1055" y="465" width="340" height="78" as="geometry"/></mxCell><mxCell id="gate" value="&lt;b&gt;Production gate&lt;/b&gt; · no named consumer means stop after staging with gateway export disabled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D35D5D;fontSize=15;" vertex="1" parent="1"><mxGeometry x="280" y="750" width="920" height="70" as="geometry"/></mxCell>
