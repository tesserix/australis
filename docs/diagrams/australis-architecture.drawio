  <diagram id="resolve" name="03 Resolution and Pinning"><mxGraphModel dx="1480" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1480" pageHeight="900" math="0" shadow="0"><root>
    <mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Resolution and pinning — fail closed before tools reach the model" style="text;html=1;strokeColor=none;fillColor=none;fontSize=25;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1200" height="38" as="geometry"/></mxCell><mxCell id="sub" value="Cache immutable descriptors per tenant configuration; apply subject scopes on every request after the cache." style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;fontColor=#5E6C84;" vertex="1" parent="1"><mxGeometry x="40" y="67" width="1100" height="26" as="geometry"/></mxCell><mxCell id="flow" value="RESOLUTION PIPELINE" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#F4F8FF;strokeColor=#7AA7E8;fontColor=#174A8B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="125" width="880" height="660" as="geometry"/></mxCell>
    <mxCell id="r1" value="&lt;b&gt;Tenant config&lt;/b&gt; · exact Registry/image digest · tool fingerprints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA7E8;fontSize=14;" vertex="1" parent="1"><mxGeometry x="90" y="190" width="780" height="58" as="geometry"/></mxCell><mxCell id="r2" value="&lt;b&gt;Registry exact fetch&lt;/b&gt; · visibility and RBAC pre-filtered" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F4FF;strokeColor=#9B7ED0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="90" y="292" width="780" height="58" as="geometry"/></mxCell><mxCell id="r3" value="&lt;b&gt;Verify immutable contract&lt;/b&gt;&lt;br&gt;signature · object/artifact digest · fingerprints · closed schemas · read-only effects · gateway-only route" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA7E8;fontSize=14;" vertex="1" parent="1"><mxGeometry x="90" y="394" width="780" height="82" as="geometry"/></mxCell><mxCell id="r4" value="&lt;b&gt;Cache descriptors before filtering&lt;/b&gt; · tenant + config revision · soft 15 min / hard 24 h" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F6EA;strokeColor=#58A36E;fontSize=14;" vertex="1" parent="1"><mxGeometry x="90" y="520" width="780" height="58" as="geometry"/></mxCell><mxCell id="r5" value="&lt;b&gt;Per-request scope filter&lt;/b&gt; · never cached · no model-controlled identity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D9;strokeColor=#D6A03D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="90" y="622" width="780" height="58" as="geometry"/></mxCell><mxCell id="out" value="&lt;b&gt;Pinned, authorized tools&lt;/b&gt;&lt;br&gt;safe for semantic selection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F6EA;strokeColor=#58A36E;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1010" y="690" width="340" height="75" as="geometry"/></mxCell><mxCell id="deny" value="&lt;b&gt;Invalid contract → fail closed&lt;/b&gt;&lt;br&gt;tool_config_invalid at load time&lt;br&gt;no partial tool set" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D35D5D;fontSize=15;" vertex="1" parent="1"><mxGeometry x="980" y="245" width="400" height="120" as="geometry"/></mxCell><mxCell id="deg" value="&lt;b&gt;Registry unavailable&lt;/b&gt;&lt;br&gt;warm cache: continue within hard TTL&lt;br&gt;cold cache: document-only or refusal&lt;br&gt;always disclose; never fabricate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D9;strokeColor=#D6A03D;fontSize=15;" vertex="1" parent="1"><mxGeometry x="980" y="445" width="400" height="145" as="geometry"/></mxCell>
    <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C7FC0;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C7FC0;" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C7FC0;" edge="1" parent="1" source="r3" target="r4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C7FC0;" edge="1" parent="1" source="r4" target="r5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#3E8C5A;" edge="1" parent="1" source="r5" target="out"><mxGeometry relative="1" as="geometry"/></mxCell>
  </root></mxGraphModel></diagram>
  <diagram id="invoke" name="04 Invocation and Degradation"><mxGraphModel dx="1480" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1480" pageHeight="900" math="0" shadow="0"><root>
    <mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="One invocation — bounded request path and explicit degradation" style="text;html=1;strokeColor=none;fillColor=none;fontSize=25;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1200" height="38" as="geometry"/></mxCell><mxCell id="sub" value="Target p99 tool budget: 400 ms. Every failure becomes a stable outcome, not an invented answer." style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;fontColor=#5E6C84;" vertex="1" parent="1"><mxGeometry x="40" y="67" width="1050" height="26" as="geometry"/></mxCell><mxCell id="path" value="REQUEST PATH" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#F4F8FF;strokeColor=#7AA7E8;fontColor=#174A8B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="125" width="860" height="660" as="geometry"/></mxCell><mxCell id="fail" value="FAILURE OUTCOMES" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#FFF8E8;strokeColor=#D9A441;fontColor=#704D00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="960" y="125" width="440" height="660" as="geometry"/></mxCell>
    <mxCell id="i1" value="1 · ADK selects allowlisted tool within budget" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA7E8;fontSize=14;" vertex="1" parent="1"><mxGeometry x="90" y="190" width="760" height="55" as="geometry"/></mxCell><mxCell id="i2" value="2 · Validate input; acquire tenant bulkhead" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA7E8;fontSize=14;" vertex="1" parent="1"><mxGeometry x="90" y="285" width="760" height="55" as="geometry"/></mxCell><mxCell id="i3" value="3 · Gateway verifies JWT, routes and injects server key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D9;strokeColor=#D6A03D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="90" y="380" width="760" height="55" as="geometry"/></mxCell><mxCell id="i4" value="4 · Ambient mTLS admits SPIFFE principal; runtime checks tool authority" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F4FF;strokeColor=#9B7ED0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="90" y="475" width="760" height="55" as="geometry"/></mxCell><mxCell id="i5" value="5 · Product API authorizes tenant/user/object" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1FBF5;strokeColor=#63A97B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="90" y="570" width="760" height="55" as="geometry"/></mxCell><mxCell id="i6" value="6 · Validate output → Evidence + Citation → confidence gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8F3;strokeColor=#C76B98;fontSize=14;" vertex="1" parent="1"><mxGeometry x="90" y="665" width="760" height="55" as="geometry"/></mxCell>
    <mxCell id="f1" value="Policy denial&lt;br&gt;&lt;b&gt;no call issued&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D9;strokeColor=#D6A03D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1005" y="205" width="350" height="70" as="geometry"/></mxCell><mxCell id="f2" value="Bulkhead full&lt;br&gt;&lt;b&gt;abandon; never queue&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D9;strokeColor=#D6A03D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1005" y="320" width="350" height="70" as="geometry"/></mxCell><mxCell id="f3" value="Dependency failure&lt;br&gt;&lt;b&gt;one bounded retry for reads&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D9;strokeColor=#D6A03D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1005" y="435" width="350" height="70" as="geometry"/></mxCell><mxCell id="f4" value="Invalid result&lt;br&gt;&lt;b&gt;discard; never cite&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D35D5D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1005" y="550" width="350" height="70" as="geometry"/></mxCell><mxCell id="f5" value="Tool unavailable&lt;br&gt;&lt;b&gt;document-only or refusal with disclosure&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D35D5D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1005" y="665" width="350" height="70" as="geometry"/></mxCell>
    <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C7FC0;" edge="1" parent="1" source="i1" target="i2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C7FC0;" edge="1" parent="1" source="i2" target="i3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C7FC0;" edge="1" parent="1" source="i3" target="i4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C7FC0;" edge="1" parent="1" source="i4" target="i5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C7FC0;" edge="1" parent="1" source="i5" target="i6"><mxGeometry relative="1" as="geometry"/></mxCell>
  </root></mxGraphModel></diagram>
  <diagram id="build" name="05 Federated Build and Publish"><mxGraphModel dx="1480" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1480" pageHeight="900" math="0" shadow="0"><root>
    <mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Federated source, one contract, independent releases" style="text;html=1;strokeColor=none;fillColor=none;fontSize=25;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1100" height="38" as="geometry"/></mxCell><mxCell id="sub" value="ADR-0004: product connectors live beside their API; only engine-owned domains live under Australis servers/." style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;fontColor=#5E6C84;" vertex="1" parent="1"><mxGeometry x="40" y="67" width="1200" height="26" as="geometry"/></mxCell>
    <mxCell id="src" value="SOURCE OWNERSHIP" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#F1FBF5;strokeColor=#63A97B;fontColor=#1B5E36;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="400" height="570" as="geometry"/></mxCell><mxCell id="ci" value="PER-CONNECTOR CI" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#F7F4FF;strokeColor=#9B7ED0;fontColor=#52357E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="540" y="130" width="400" height="570" as="geometry"/></mxCell><mxCell id="out" value="PUBLISHED ARTIFACTS" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#FFF8E8;strokeColor=#D9A441;fontColor=#704D00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1040" y="130" width="400" height="570" as="geometry"/></mxCell>
    <mxCell id="s1" value="&lt;b&gt;Product repository&lt;/b&gt;&lt;br&gt;mark8ly/services/mcp/&lt;br&gt;equivalent bounded product path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#63A97B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="85" y="215" width="310" height="95" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;Australis repository&lt;/b&gt;&lt;br&gt;servers/ only for engine-owned data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FF;strokeColor=#7AA7E8;fontSize=14;" vertex="1" parent="1"><mxGeometry x="85" y="390" width="310" height="85" as="geometry"/></mxCell><mxCell id="c1" value="1 · lint + test + typecheck" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B7ED0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="585" y="205" width="310" height="55" as="geometry"/></mxCell><mxCell id="c2" value="2 · conformance + adversarial security" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B7ED0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="585" y="305" width="310" height="55" as="geometry"/></mxCell><mxCell id="c3" value="3 · image + SBOM + scan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B7ED0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="585" y="405" width="310" height="55" as="geometry"/></mxCell><mxCell id="c4" value="4 · immutable digest + evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B7ED0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="585" y="505" width="310" height="55" as="geometry"/></mxCell><mxCell id="o1" value="&lt;b&gt;Product image&lt;/b&gt;&lt;br&gt;one server · one rollback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9A441;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1085" y="215" width="310" height="75" as="geometry"/></mxCell><mxCell id="o2" value="&lt;b&gt;tesserix-k8s&lt;/b&gt;&lt;br&gt;Deployment · SA · mesh · secrets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9A441;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1085" y="365" width="310" height="75" as="geometry"/></mxCell><mxCell id="o3" value="&lt;b&gt;devai Registry seed&lt;/b&gt;&lt;br&gt;MCPServer + credentialRef" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9A441;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1085" y="515" width="310" height="75" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Blast-radius rule&lt;/b&gt; · one connector change rebuilds and promotes only that connector; never synchronize unrelated product images under one tag." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D35D5D;fontSize=15;" vertex="1" parent="1"><mxGeometry x="230" y="760" width="1020" height="70" as="geometry"/></mxCell>
    <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#3E8C5A;" edge="1" parent="1" source="s1" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7B5CB5;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7B5CB5;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7B5CB5;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#B57B12;" edge="1" parent="1" source="c4" target="o3"><mxGeometry relative="1" as="geometry"/></mxCell>
  </root></mxGraphModel></diagram>
  <diagram id="flywheel" name="06 Learning Flywheel"><mxGraphModel dx="1480" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1480" pageHeight="900" math="0" shadow="0"><root>
    <mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Learning flywheel — serving remains independent from learning" style="text;html=1;strokeColor=none;fillColor=none;fontSize=25;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1100" height="38" as="geometry"/></mxCell><mxCell id="sub" value="Capture is asynchronous and optional. Promotion is evidence-gated; no training output reaches serving automatically." style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;fontColor=#5E6C84;" vertex="1" parent="1"><mxGeometry x="40" y="67" width="1150" height="26" as="geometry"/></mxCell>
    <mxCell id="n1" value="&lt;b&gt;1 · Serve&lt;/b&gt;&lt;br&gt;ground + cite" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FF;strokeColor=#5B8FD8;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="165" width="220" height="90" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;2 · Capture&lt;/b&gt;&lt;br&gt;async + redacted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEE7FA;strokeColor=#8D6BC1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="340" y="165" width="220" height="90" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;3 · Signals&lt;/b&gt;&lt;br&gt;review + outcomes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D9;strokeColor=#D6A03D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="620" y="165" width="220" height="90" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;4 · Corpus&lt;/b&gt;&lt;br&gt;partition, then filter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEE7FA;strokeColor=#8D6BC1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="900" y="165" width="220" height="90" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;5 · Train candidate&lt;/b&gt;&lt;br&gt;reproducible digests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEE7FA;strokeColor=#8D6BC1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1180" y="165" width="220" height="90" as="geometry"/></mxCell><mxCell id="gate" value="&lt;b&gt;6 · Evaluation + promotion&lt;/b&gt;&lt;br&gt;offline → shadow → canary → promote&lt;br&gt;quality · citations · refusals · p99 · cost · human approval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D9;strokeColor=#D6A03D;fontSize=15;" vertex="1" parent="1"><mxGeometry x="350" y="390" width="780" height="130" as="geometry"/></mxCell><mxCell id="guard" value="&lt;b&gt;Structural grounding&lt;/b&gt;&lt;br&gt;source assembly, citation validation and refusal policy stay around the model." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F6EA;strokeColor=#58A36E;fontSize=14;" vertex="1" parent="1"><mxGeometry x="120" y="640" width="560" height="100" as="geometry"/></mxCell><mxCell id="fail" value="&lt;b&gt;Failure isolation&lt;/b&gt;&lt;br&gt;capture, corpus, training and eval outages never block a product request." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D35D5D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="800" y="640" width="560" height="100" as="geometry"/></mxCell>
    <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#7B5CB5;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#7B5CB5;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#7B5CB5;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#7B5CB5;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#D6A03D;exitX=0.5;exitY=1;entryX=0.85;entryY=0;" edge="1" parent="1" source="n5" target="gate"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1290" y="325"/><mxPoint x="1010" y="325"/></Array></mxGeometry></mxCell>
  </root></mxGraphModel></diagram>
  <diagram id="tiers" name="07 Learning Tiers"><mxGraphModel dx="1480" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1480" pageHeight="900" math="0" shadow="0"><root>
    <mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Three learning tiers — share policy, isolate content" style="text;html=1;strokeColor=none;fillColor=none;fontSize=25;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1200" height="38" as="geometry"/></mxCell><mxCell id="sub" value="Partition before filtering. Tenant content never enters shared weights; HMS remains excluded by construction." style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;fontColor=#5E6C84;" vertex="1" parent="1"><mxGeometry x="40" y="67" width="1150" height="26" as="geometry"/></mxCell>
    <mxCell id="a" value="&lt;b&gt;T0 · POLICY&lt;/b&gt;&lt;br&gt;&lt;br&gt;Routing, tool selection, retrieval weights, confidence thresholds&lt;br&gt;&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; metadata + aggregate outcomes&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; configuration, not weights&lt;br&gt;&lt;b&gt;Shared:&lt;/b&gt; all tenants; no content" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F6EA;strokeColor=#58A36E;fontSize=14;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="430" height="300" as="geometry"/></mxCell><mxCell id="b" value="&lt;b&gt;T1 · BEHAVIOUR&lt;/b&gt;&lt;br&gt;&lt;br&gt;Answer format, citations, refusal style, honest escalation&lt;br&gt;&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; de-identified consented traces&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; behavior adapter&lt;br&gt;&lt;b&gt;Shared:&lt;/b&gt; opt-in only; HMS excluded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D9;strokeColor=#D6A03D;fontSize=14;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="525" y="140" width="430" height="300" as="geometry"/></mxCell><mxCell id="c" value="&lt;b&gt;T2 · DOMAIN&lt;/b&gt;&lt;br&gt;&lt;br&gt;One product's vocabulary, reasoning and grounding&lt;br&gt;&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; one tenant's approved traces&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; adapter per tenant&lt;br&gt;&lt;b&gt;Shared:&lt;/b&gt; never; adapters never merge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D35D5D;fontSize=14;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="1010" y="140" width="430" height="300" as="geometry"/></mxCell><mxCell id="model" value="&lt;b&gt;Served model = swappable base + optional T1 behavior adapter + tenant-only T2 adapter + T0 policy configuration&lt;/b&gt;&lt;br&gt;&lt;br&gt;Every artifact binds to source, snapshot, dataset and evaluation digests." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FF;strokeColor=#5B8FD8;fontSize=15;" vertex="1" parent="1"><mxGeometry x="160" y="535" width="1160" height="115" as="geometry"/></mxCell><mxCell id="erase" value="&lt;b&gt;Erasure path&lt;/b&gt; · delete eligible traces → rebuild snapshot → retrain → evaluate → promote. Never patch adapters in place." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D9;strokeColor=#D6A03D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="260" y="730" width="960" height="70" as="geometry"/></mxCell>
  </root></mxGraphModel></diagram>
</mxfile>
