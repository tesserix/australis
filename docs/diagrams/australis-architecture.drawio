  <diagram id="ctx" name="01 System Context"><mxGraphModel dx="1480" dy="950" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1480" pageHeight="950" math="0" shadow="0"><root>
    <mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Australis — grounded agents with product-owned MCP connectors" style="text;html=1;strokeColor=none;fillColor=none;fontSize=25;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1200" height="38" as="geometry"/></mxCell><mxCell id="sub" value="Solid: request path. Dashed: discovery, reconciliation or telemetry. Ownership follows data and release boundaries." style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;fontColor=#5E6C84;" vertex="1" parent="1"><mxGeometry x="40" y="67" width="1200" height="26" as="geometry"/></mxCell>
    <mxCell id="lu" value="PRODUCT EXPERIENCE" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#F4F8FF;strokeColor=#7AA7E8;fontColor=#174A8B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="125" width="280" height="600" as="geometry"/></mxCell><mxCell id="la" value="AUSTRALIS / ADK" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#F7F4FF;strokeColor=#9B7ED0;fontColor=#52357E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="350" y="125" width="330" height="600" as="geometry"/></mxCell><mxCell id="lp" value="AGENTIC PLATFORM" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#FFF8E8;strokeColor=#D9A441;fontColor=#704D00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="710" y="125" width="330" height="600" as="geometry"/></mxCell><mxCell id="lm" value="PRODUCT-OWNED MCP" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#F1FBF5;strokeColor=#63A97B;fontColor=#1B5E36;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1070" y="125" width="370" height="600" as="geometry"/></mxCell>
    <mxCell id="user" value="&lt;b&gt;Product user&lt;/b&gt;&lt;br&gt;question or task" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA7E8;fontSize=14;" vertex="1" parent="1"><mxGeometry x="75" y="245" width="210" height="70" as="geometry"/></mxCell><mxCell id="app" value="&lt;b&gt;Product app / BFF&lt;/b&gt;&lt;br&gt;session · tenant · request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA7E8;fontSize=14;" vertex="1" parent="1"><mxGeometry x="75" y="405" width="210" height="75" as="geometry"/></mxCell><mxCell id="agent" value="&lt;b&gt;Australis agent + ADK&lt;/b&gt;&lt;br&gt;plan · select · budgets&lt;br&gt;ground · cite · degrade" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B7ED0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="395" y="390" width="240" height="105" as="geometry"/></mxCell><mxCell id="kb" value="&lt;b&gt;Knowledge adapters&lt;/b&gt;&lt;br&gt;documents + MCP ToolRetriever" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEE7FA;strokeColor=#9B7ED0;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395" y="565" width="240" height="75" as="geometry"/></mxCell>
    <mxCell id="reg" value="&lt;b&gt;Agentic Registry&lt;/b&gt;&lt;br&gt;catalog + desired routes&lt;br&gt;not on request path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9A441;fontSize=14;" vertex="1" parent="1"><mxGeometry x="755" y="205" width="240" height="85" as="geometry"/></mxCell><mxCell id="sync" value="&lt;b&gt;Route-sync&lt;/b&gt;&lt;br&gt;last-known-good reconcile&lt;br&gt;Backend · HTTPRoute · policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9A441;fontSize=14;" vertex="1" parent="1"><mxGeometry x="755" y="330" width="240" height="92" as="geometry"/></mxCell><mxCell id="gw" value="&lt;b&gt;AgentGateway&lt;/b&gt;&lt;br&gt;verify Zitadel JWT&lt;br&gt;route + inject X-MCP-Key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9A441;fontSize=14;" vertex="1" parent="1"><mxGeometry x="755" y="485" width="240" height="92" as="geometry"/></mxCell><mxCell id="mcp" value="&lt;b&gt;Product MCP service&lt;/b&gt;&lt;br&gt;own image · ServiceAccount&lt;br&gt;SPIFFE · tool policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#63A97B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1110" y="480" width="290" height="100" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;Product API + data&lt;/b&gt;&lt;br&gt;separate credential&lt;br&gt;tenant/user/object authorization" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#63A97B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1110" y="625" width="290" height="90" as="geometry"/></mxCell><mxCell id="obs" value="&lt;b&gt;Observability + evaluations&lt;/b&gt;&lt;br&gt;one W3C trace · RED metrics · grounding/citation scores · payload-free telemetry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8F3;strokeColor=#C76B98;fontSize=14;" vertex="1" parent="1"><mxGeometry x="350" y="785" width="1090" height="80" as="geometry"/></mxCell>
    <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#4C7FC0;" edge="1" parent="1" source="user" target="app"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="request" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#4C7FC0;" edge="1" parent="1" source="app" target="agent"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="JWT + trace" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#7B5CB5;" edge="1" parent="1" source="agent" target="gw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="mTLS + key" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#B57B12;" edge="1" parent="1" source="gw" target="mcp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#3E8C5A;" edge="1" parent="1" source="mcp" target="api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="discover + pin" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#7B5CB5;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="reg" target="agent"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="695" y="247"/><mxPoint x="515" y="247"/></Array></mxGeometry></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#B57B12;" edge="1" parent="1" source="reg" target="sync"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#B57B12;" edge="1" parent="1" source="sync" target="gw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#C76B98;exitX=1;exitY=0.75;entryX=0.3;entryY=0;" edge=