<mxfile host="app.diagrams.net" modified="2026-09-02T00:00:00.000Z" agent="Australis" version="24.7.17" type="device">

  <diagram name="01 Context and Ownership" id="ctx">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t1" value="Australis — MCP Knowledge Connectors (System Context)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="32" as="geometry" /></mxCell>
        <mxCell id="t2" value="ADR-0001 · The Registry is a catalog and never on the request path · The Gateway is the request path and never the authoriser · The MCP runtime authorises every call, default-deny" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1600" height="20" as="geometry" /></mxCell>

        <mxCell id="gProd" value="Product repos — own the data, own the MCP server (D1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;verticalAlign=top;fontStyle=1;fontColor=#3d6b2e;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="470" height="420" as="geometry" /></mxCell>
        <mxCell id="pKora" value="kora&#10;&#10;mcp/kora-logs&#10;Kora Postgres" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="70" y="140" width="190" height="90" as="geometry" /></mxCell>
        <mxCell id="pM8" value="mark8ly&#10;&#10;mcp/mark8ly-catalog&#10;mcp/mark8ly-orders" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="290" y="140" width="190" height="90" as="geometry" /></mxCell>
        <mxCell id="pHC" value="home-chef&#10;&#10;mcp/home-chef-recipes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="70" y="260" width="190" height="90" as="geometry" /></mxCell>
        <mxCell id="pHMS" value="hms&#10;&#10;deferred — sets the&#10;isolation bar (PRD §4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="290" y="260" width="190" height="90" as="geometry" /></mxCell>
        <mxCell id="pNote" value="Rule D1 — an MCP server is owned by the repo that owns its data.&#10;Co-locating it with the engine would make every schema change an&#10;engine change, breaking PRD §3: &quot;new tenant = connector + config,&#10;zero engine-core changes&quot;." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="380" width="410" height="110" as="geometry" /></mxCell>

        <mxCell id="gCP" value="Control plane — existing Tesserix platform" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;verticalAlign=top;fontStyle=1;fontColor=#6b4c85;" vertex="1" parent="1"><mxGeometry x="560" y="100" width="470" height="260" as="geometry" /></mxCell>
        <mxCell id="reg" value="Agentic Registry&#10;&#10;catalog: metadata + bytes&#10;SHA-256 content-addressed&#10;visibility/RBAC pre-filter&#10;signs what it serves" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="590" y="140" width="190" height="120" as="geometry" /></mxCell>
        <mxCell id="agw" value="AgentGateway&#10;&#10;AgentgatewayBackend&#10;+ HTTPRoute per server&#10;{gw}/mcp/&lt;name&gt;&#10;mTLS · per-tenant limits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="810" y="140" width="190" height="120" as="geometry" /></mxCell>
        <mxCell id="cpNote" value="Neither is an authoriser. Discovery returns candidates only;&#10;the MCP runtime re-authorises per tool at call time (D4)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="590" y="285" width="410" height="55" as="geometry" /></mxCell>

        <mxCell id="gAus" value="australis — this repo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;fontStyle=1;fontColor=#3b5c8a;" vertex="1" parent="1"><mxGeometry x="560" y="390" width="1080" height="330" as="geometry" /></mxCell>
        <mxCell id="core" value="internal/core&#10;&#10;ports · evidence · retrieval · compose&#10;&#10;MUST NOT import any MCP SDK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="590" y="430" width="230" height="120" as="geometry" /></mxCell>
        <mxCell id="port" value="ToolRetriever&#10;(port)&#10;&#10;Tools()&#10;Invoke()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="860" y="440" width="150" height="100" as="geometry" /></mxCell>
        <mxCell id="adp" value="internal/adapter/mcp&#10;&#10;discovery · resolver&#10;client · evidence&#10;&#10;the ONLY package that&#10;knows MCP exists (D2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1050" y="430" width="200" height="120" as="geometry" /></mxCell>
        <mxCell id="srv" value="servers/&#10;&#10;australis-evals&#10;australis-kb-admin&#10;&#10;engine-owned only (D5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1290" y="430" width="180" height="120" as="geometry" /></mxCell>
        <mxCell id="ausdb" value="Postgres + pgvector&#10;per-tenant namespaces" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="590" y="580" width="180" height="110" as="geometry" /></mxCell>
        <mxCell id="ausNote" value="D2 — MCP is an adapter, not an assumption. A tenant arriving with a plain signed-HTTP connector is onboarded by writing an adapter, with no change to core. Enforced in CI, not by convention (LLD §7)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="810" y="580" width="440" height="80" as="geometry" /></mxCell>

        <mxCell id="bff" value="Product BFF&#10;credentials · timeouts&#10;circuit breaker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1290" y="140" width="180" height="80" as="geometry" /></mxCell>
        <mxCell id="ui" value="Product UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1290" y="250" width="180" height="50" as="geometry" /></mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="pKora" target="reg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1l" value="publish manifest" style="edgeLabel;html=1;fontSize=10;fontColor=#3d6b2e;" vertex="1" connectable="0" parent="e1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;dashed=1;fontSize=10;" edge="1" parent="1" source="reg" target="agw"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2l" value="adapter → GitOps route" style="edgeLabel;html=1;fontSize=10;fontColor=#6b4c85;" vertex="1" connectable="0" parent="e2"><mxGeometry x="0" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;fontSize=10;" edge="1" parent="1" source="adp" target="reg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3l" value="resolve + pin digests&#10;(config load, cached)" style="edgeLabel;html=1;fontSize=10;fontColor=#3b5c8a;" vertex="1" connectable="0" parent="e3"><mxGeometry x="0" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="adp" target="agw"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4l" value="invoke — Streamable HTTP&#10;p99 budget 400 ms" style="edgeLabel;html=1;fontSize=10;fontColor=#b85450;" vertex="1" connectable="0" parent="e4"><mxGeometry x="0" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="agw" target="pKora"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5l" value="route to server" style="edgeLabel;html=1;fontSize=10;fontColor=#b85450;" vertex="1" connectable="0" parent="e5"><mxGeometry x="0" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="ui" target="bff"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="bff" target="core"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7l" value="POST /chat (HTTP + SSE)" style="edgeLabel;html=1;fontSize=10;fontColor=#b85450;" vertex="1" connectable="0" parent="e7"><mxGeometry x="0" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d79b00;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="core" target="port"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontSize=10;" edge="1" parent="1" source="adp" target="port"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9l" value="implements" style="edgeLabel;html=1;fontSize=10;fontColor=#d79b00;" vertex="1" connectable="0" parent="e9"><mxGeometry x="0" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;fontSize=10;" edge="1" parent="1" source="core" target="ausdb"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="leg" value="Legend&#10;&#10;green = product-owned    purple = platform control plane    blue = Australis    red = request path    orange = the port seam" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacing=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="470" height="90" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="02 Connector Lifecycle" id="lifecycle">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="lt1" value="Lifecycle of one connector — six stages" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="32" as="geometry" /></mxCell>
        <mxCell id="lt2" value="Stages 1–3 run in the product's repo and CI. Stages 4–6 run in Australis. HLD §4." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontStyle=2;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1200" height="20" as="geometry" /></mxCell>

        <mxCell id="lane1" value="Product repo + CI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;verticalAlign=top;fontStyle=1;fontColor=#3d6b2e;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="800" height="300" as="geometry" /></mxCell>
        <mxCell id="lane2" value="Australis (request time)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;fontStyle=1;fontColor=#3b5c8a;" vertex="1" parent="1"><mxGeometry x="880" y="100" width="780" height="300" as="geometry" /></mxCell>

        <mxCell id="s1" value="1 · AUTHOR&#10;&#10;typed callable_tool&#10;closed Pydantic in/out&#10;scopes + effects&#10;identity from CallContext" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="150" width="220" height="130" as="geometry" /></mxCell>
        <mxCell id="s2" value="2 · COMPILE&#10;&#10;tesserix-mcp-manifest&#10;→ server.json (portable)&#10;→ MCPServer envelope&#10;schema fingerprints emitted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="150" width="220" height="130" as="geometry" /></mxCell>
        <mxCell id="s3" value="3 · PUBLISH&#10;&#10;agentic apply -f …&#10;SHA-256 addressed, idempotent&#10;new tag = new revision&#10;GitOps → gateway route" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="150" width="230" height="130" as="geometry" /></mxCell>
        <mxCell id="s4" value="4 · RESOLVE&#10;&#10;search → fetch exact&#10;verify signature&#10;pin registry + artifact digest&#10;check tool fingerprints&#10;cache per (tenant, cfg rev)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="910" y="150" width="230" height="130" as="geometry" /></mxCell>
        <mxCell id="s5" value="5 · SELECT&#10;&#10;planner picks 0..N tools&#10;from semantic metadata&#10;summary / when_to_use / not_for&#10;&#10;a hint, never authority" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1170" y="150" width="220" height="130" as="geometry" /></mxCell>
        <mxCell id="s6" value="6 · INVOKE&#10;&#10;via AgentGateway&#10;deadline · bulkhead&#10;validate output schema&#10;→ Evidence + Citation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1420" y="150" width="215" height="130" as="geometry" /></mxCell>

        <mxCell id="le1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#999999;dashed=1;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="conv" value="Where the two knowledge kinds meet (HLD §5) — one Evidence list, one confidence gate" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="900" height="24" as="geometry" /></mxCell>
        <mxCell id="cDoc" value="Document KB&#10;hybrid retrieval&#10;dense ∪ FTS → RRF → rerank" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=top;spacingTop=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="490" width="230" height="80" as="geometry" /></mxCell>
        <mxCell id="cTool" value="Tool KB (MCP)&#10;select → gateway invoke&#10;→ validated typed result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=top;spacingTop=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="600" width="230" height="80" as="geometry" /></mxCell>
        <mxCell id="cEv" value="[]Evidence&#10;&#10;every item carries a&#10;mandatory Citation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="380" y="535" width="180" height="100" as="geometry" /></mxCell>
        <mxCell id="cGate" value="Confidence gate&#10;&#10;below threshold →&#10;honest escalation,&#10;never a guess (PRD §12)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="620" y="535" width="190" height="100" as="geometry" /></mxCell>
        <mxCell id="cAns" value="Cited answer&#10;(SSE stream)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="870" y="560" width="160" height="50" as="geometry" /></mxCell>
        <mxCell id="ce1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="cDoc" target="cEv"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="cTool" target="cEv"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="cEv" target="cGate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="cGate" target="cAns"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cNote" value="The two branches are independent failure domains. Tool-KB failure degrades the answer to document-only with an explicit disclosure and returns 200.&#10;Document-KB failure is critical. Neither runs inside the other's synchronous section — that separation is what makes the degradation table in ADR-0001 true." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="520" width="560" height="130" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="03 Resolution and Pinning" id="resolve">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="rt1" value="Resolution and digest pinning — fail closed at every step" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="32" as="geometry" /></mxCell>
        <mxCell id="rt2" value="Runs once per tenant-config revision, not per request. LLD §3. Every failure is a config error surfaced at load — never a 500 at 3 a.m." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontStyle=2;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1200" height="20" as="geometry" /></mxCell>

        <mxCell id="rCfg" value="Tenant config (config-as-code — assumption, PRD §20)&#10;ref @1.2.3 · registry_digest · artifact_digest · tool fingerprints · deadline_ms 400 · max_calls_per_turn 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;align=left;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="620" height="70" as="geometry" /></mxCell>

        <mxCell id="r1" value="1 · GET /v0/search?kinds=MCPServer&amp;view=stub&amp;namespace=…&#10;Registry-authorised stubs — visibility/RBAC pre-filter already applied" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="620" height="60" as="geometry" /></mxCell>
        <mxCell id="r2" value="2 · same-origin fetch via stub.fetchPath → exact MCPServer object" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="285" width="620" height="45" as="geometry" /></mxCell>
        <mxCell id="r3" value="V1 · verify signature against GET /v0/signing-key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="355" width="620" height="40" as="geometry" /></mxCell>
        <mxCell id="r4" value="V2 · object digest == config.registry_digest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="405" width="620" height="40" as="geometry" /></mxCell>
        <mxCell id="r5" value="V3 · deployed artifact digest == config.artifact_digest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="455" width="620" height="40" as="geometry" /></mxCell>
        <mxCell id="r6" value="V4 · every tool input/output fingerprint matches config" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="505" width="620" height="40" as="geometry" /></mxCell>
        <mxCell id="r7" value="V5 · output schema present and closed (no citation without a typed result)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="555" width="620" height="40" as="geometry" /></mxCell>
        <mxCell id="r8" value="V6 · all effects read-only (ADR-0001 D6 — v1 has no writes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="605" width="620" height="40" as="geometry" /></mxCell>
        <mxCell id="r9" value="V7 · route_policy.direct_access == false (all traffic via gateway, D4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="655" width="620" height="40" as="geometry" /></mxCell>
        <mxCell id="r10" value="V8 · no tenant/user-identity-shaped property in any input schema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="705" width="620" height="40" as="geometry" /></mxCell>
        <mxCell id="r11" value="cache under (tenant_id, config_revision) — LRU 500, soft TTL 15 min, hard TTL 24 h" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;align=left;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="765" width="620" height="45" as="geometry" /></mxCell>
        <mxCell id="r12" value="pinned, authorised tool set&#10;ready for ToolRetriever.Tools()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="850" width="300" height="55" as="geometry" /></mxCell>

        <mxCell id="rFail" value="FAIL CLOSED&#10;&#10;code: tool_config_invalid&#10;HTTP 500 at config load&#10;&#10;The tenant owner is paged.&#10;No partial tool set is ever&#10;admitted — a half-verified&#10;connector is worse than none,&#10;because its answers still&#10;look cited." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;align=left;spacing=8;verticalAlign=top;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="740" y="380" width="280" height="220" as="geometry" /></mxCell>
        <mxCell id="rDeg" value="Registry unavailable → DEGRADABLE&#10;&#10;warm cache (within hard TTL)&#10;  → serve soft-expired entry&#10;&#10;cold cache&#10;  → code: tool_retriever_unavailable&#10;  → HTTP 200, document-only answer&#10;  → disclose &quot;live data unavailable&quot;&#10;&#10;Never guess. Never fabricate.&#10;A missing tool degrades an answer;&#10;it does not fail a request." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=8;verticalAlign=top;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="740" y="630" width="280" height="240" as="geometry" /></mxCell>

        <mxCell id="rf1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="r3" target="rFail"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="rf2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="r6" target="rFail"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="rf3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="r10" target="rFail"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="rd1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;dashed=1;" edge="1" parent="1" source="r1" target="rDeg"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="re0" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;" edge="1" parent="1" source="rCfg" target="r1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;" edge="1" parent="1" source="r3" target="r4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;" edge="1" parent="1" source="r4" target="r5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;" edge="1" parent="1" source="r5" target="r6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re6" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;" edge="1" parent="1" source="r6" target="r7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re7" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;" edge="1" parent="1" source="r7" target="r8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re8" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;" edge="1" parent="1" source="r8" target="r9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re9" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;" edge="1" parent="1" source="r9" target="r10"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re10" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="r10" target="r11"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re11" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="r11" target="r12"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="04 Invocation and Degradation" id="invoke">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="it1" value="Request-time invocation — one chat turn" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="32" as="geometry" /></mxCell>
        <mxCell id="it2" value="LLD §4 · p99 budget: BFF 50 + engine 30 + retrieval 150 + MCP 400 + model TTFT 1200 = 1830 ms against a 2500 ms target (670 ms headroom)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontStyle=2;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1400" height="20" as="geometry" /></mxCell>

        <mxCell id="i1" value="planner selects tool&#10;(bounded: max_calls_per_turn = 3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="270" height="55" as="geometry" /></mxCell>
        <mxCell id="i2" value="V9 · validate Arguments against InputSchema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="195" width="270" height="50" as="geometry" /></mxCell>
        <mxCell id="i3" value="acquire per-tenant bulkhead slot&#10;maxInFlight 8 · maxConns 4 · wait 50 ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="275" width="270" height="55" as="geometry" /></mxCell>
        <mxCell id="i4" value="POST {gateway}/mcp/&lt;server&gt;&#10;Streamable HTTP&#10;deadline = min(400 ms, remaining turn budget)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="270" height="70" as="geometry" /></mxCell>
        <mxCell id="i5" value="MCP runtime re-authorises&#10;per-tool scopes, default-deny&#10;(discovery granted nothing)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="460" width="270" height="65" as="geometry" /></mxCell>
        <mxCell id="i6" value="V10 · validate result against OutputSchema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="555" width="270" height="50" as="geometry" /></mxCell>
        <mxCell id="i7" value="map to []Evidence&#10;Citation{Source, Locator, Digest}&#10;Retrieved timestamp — freshness disclosed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="635" width="270" height="70" as="geometry" /></mxCell>
        <mxCell id="i8" value="RRF fusion with document evidence&#10;→ confidence gate → cited answer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="735" width="270" height="60" as="geometry" /></mxCell>

        <mxCell id="ie1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="i1" target="i2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ie2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="i2" target="i3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ie3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="i3" target="i4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ie4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="i4" target="i5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ie5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="i5" target="i6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ie6" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="i6" target="i7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ie7" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="i7" target="i8"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="dOff" value="Degradation — what happens instead" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="110" width="500" height="24" as="geometry" /></mxCell>
        <mxCell id="d2" value="schema mismatch → no call issued&#10;planner told the tool is unavailable this turn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430" y="190" width="330" height="55" as="geometry" /></mxCell>
        <mxCell id="d3" value="bulkhead full → ABANDON, do not queue&#10;queueing turns a latency problem into a&#10;timeout cascade; the answer degrades instead" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430" y="270" width="330" height="65" as="geometry" /></mxCell>
        <mxCell id="d4" value="gateway 503 / connect failure → ONE retry&#10;(safe: every v1 tool is a read)&#10;timeout → NO retry — work likely already done" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430" y="360" width="330" height="70" as="geometry" /></mxCell>
        <mxCell id="d6" value="output invalid → result DISCARDED&#10;never cited; an unattributable claim does not ship" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430" y="550" width="330" height="60" as="geometry" /></mxCell>
        <mxCell id="dAll" value="any of the above →&#10;HTTP 200, document-only answer&#10;code: tool_retriever_unavailable&#10;with explicit disclosure to the user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;align=left;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430" y="720" width="330" height="90" as="geometry" /></mxCell>
        <mxCell id="de1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;dashed=1;" edge="1" parent="1" source="i2" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;dashed=1;" edge="1" parent="1" source="i3" target="d3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;dashed=1;" edge="1" parent="1" source="i4" target="d4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;dashed=1;" edge="1" parent="1" source="i6" target="d6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d79b00;dashed=1;strokeWidth=2;" edge="1" parent="1" source="dAll" target="i8"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="tiers" value="Dependency tiers (ADR-0001)&#10;&#10;Agentic Registry        DEGRADABLE  — serve cache; refuse only if cold&#10;AgentGateway            CRITICAL per tenant — that tenant loses live data only&#10;Tenant MCP server       DEGRADABLE  — bulkheaded, cannot starve other tenants&#10;Postgres + pgvector     CRITICAL     — document retrieval fails → 503&#10;Model provider          DEGRADABLE  — router falls back per tenant policy&#10;Australis itself        OPTIONAL to the host product — BFF circuit-breaks&#10;&#10;Error contract: clients branch on code, never on message text.&#10;  tool_retriever_unavailable   200 + partial   render with disclosure&#10;  tool_config_invalid          500             page the tenant owner&#10;  tool_budget_exhausted        200 + partial   render with disclosure&#10;  knowledge_unavailable        503             BFF circuit-breaks" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacing=10;verticalAlign=top;spacingTop=10;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="830" y="150" width="700" height="380" as="geometry" /></mxCell>

        <mxCell id="sizing" value="Why this is small&#10;&#10;Peak MCP tool-call rate      ~5 RPS   (5,000 DAU x 3 chats x 3 tools, 8x diurnal peak)&#10;Resolved-manifest working set  &lt; 2 MB   (~100 manifests x ~20 KB)&#10;&#10;Therefore: in-process LRU cache, not Redis. N stateless replicas, not a&#10;queue. One Postgres, not a shard. If a follow-up design for this path&#10;introduces Kafka or a separate tool-execution service, the numbers have&#10;not changed and the design has." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=10;verticalAlign=top;spacingTop=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="830" y="560" width="700" height="200" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="05 Monorepo Build and Publish" id="build">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="bt1" value="Monorepo of source, polyrepo of artifacts" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="32" as="geometry" /></mxCell>
        <mxCell id="bt2" value="ADR-0001 · One repo holds every connector. Sharing a repository never means sharing a failure domain: each server is its own build unit, image, Registry object, credential and deployment." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontStyle=2;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1600" height="20" as="geometry" /></mxCell>

        <mxCell id="bSrc" value="australis/servers/ — one source tree" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;verticalAlign=top;fontStyle=1;fontColor=#3d6b2e;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="380" height="380" as="geometry" /></mxCell>
        <mxCell id="bK" value="kora/logs/&#10;CODEOWNERS: Kora team" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="145" width="320" height="50" as="geometry" /></mxCell>
        <mxCell id="bM" value="mark8ly/catalog/&#10;CODEOWNERS: mark8ly team" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="210" width="320" height="50" as="geometry" /></mxCell>
        <mxCell id="bH" value="home-chef/recipes/&#10;CODEOWNERS: home-chef team" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="275" width="320" height="50" as="geometry" /></mxCell>
        <mxCell id="bE" value="australis-evals/&#10;CODEOWNERS: engine team" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="340" width="320" height="50" as="geometry" /></mxCell>
        <mxCell id="bSh" value="_shared/  — vetted library. Keep small, or empty." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="70" y="405" width="320" height="40" as="geometry" /></mxCell>

        <mxCell id="bCI" value="Path-filtered CI — a change under one server rebuilds ONLY that server" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;verticalAlign=top;fontStyle=1;fontColor=#6b4c85;" vertex="1" parent="1"><mxGeometry x="470" y="100" width="640" height="380" as="geometry" /></mxCell>
        <mxCell id="c1" value="lint · typecheck" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="145" width="270" height="40" as="geometry" /></mxCell>
        <mxCell id="c2" value="conformance testkit (no network)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="200" width="270" height="40" as="geometry" /></mxCell>
        <mxCell id="c3" value="compile manifests&#10;assert committed == fresh compile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="255" width="270" height="50" as="geometry" /></mxCell>
        <mxCell id="c4" value="build image · push to GHCR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="320" width="270" height="40" as="geometry" /></mxCell>
        <mxCell id="c5" value="agentic apply · wait for activation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="375" width="270" height="40" as="geometry" /></mxCell>
        <mxCell id="cN" value="NIGHTLY, separately:&#10;contract tests against each product's&#10;staging API → open an issue on drift.&#10;&#10;This is the mitigation for the one real&#10;cost of the monorepo: schema drift that&#10;no product test would catch, producing&#10;a connector that returns wrong data the&#10;assistant then cites confidently.&#10;&#10;Ships in Phase 1. Not optional." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=8;verticalAlign=top;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="810" y="145" width="280" height="270" as="geometry" /></mxCell>
        <mxCell id="be1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="be2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="be3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="be4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="be0" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="bK" target="c1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="bArt" value="Runtime — nothing shared" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;verticalAlign=top;fontStyle=1;fontColor=#a02020;" vertex="1" parent="1"><mxGeometry x="1160" y="100" width="480" height="380" as="geometry" /></mxCell>
        <mxCell id="a1" value="kora-logs image&#10;own Deployment · own SPIFFE ID · own credential&#10;→ Kora's DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1190" y="145" width="420" height="60" as="geometry" /></mxCell>
        <mxCell id="a2" value="mark8ly-catalog image&#10;own Deployment · own SPIFFE ID · own credential&#10;→ mark8ly's DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1190" y="220" width="420" height="60" as="geometry" /></mxCell>
        <mxCell id="a3" value="home-chef-recipes image&#10;own Deployment · own SPIFFE ID · own credential" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1190" y="295" width="420" height="55" as="geometry" /></mxCell>
        <mxCell id="a4" value="D7 — an on-prem HMS bundle is assembled from an&#10;explicit server list, so it contains HMS servers and no others.&#10;Verified by a test on the bundle, not by inspection." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1190" y="365" width="420" height="80" as="geometry" /></mxCell>
        <mxCell id="be5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="c5" target="a1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="bInv" value="Enforced in CI, not by convention&#10;&#10;  1.  internal/core/    may not import internal/adapter/ or any MCP SDK&#10;  2.  exactly one package may import the MCP SDK  (internal/adapter/mcp)&#10;  3.  internal/         may not import servers/          ← keeps the monorepo honest&#10;  4.  a server          may not import another server&#10;  5.  committed manifests must equal a fresh compile&#10;&#10;Check 3 is the load-bearing one. Without it, the first person in a hurry imports a&#10;server package directly and the isolation argument stops being true." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacing=10;verticalAlign=top;spacingTop=10;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="1070" height="230" as="geometry" /></mxCell>
        <mxCell id="bExit" value="The exit, if this goes badly&#10;&#10;Because each server is already an&#10;independent build unit with its own&#10;image and CODEOWNERS, moving one&#10;to a product repo is git filter-repo&#10;plus a CI file.&#10;&#10;That reversibility is why D1 is a rule&#10;and not a suggestion." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=10;verticalAlign=top;spacingTop=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1160" y="520" width="480" height="230" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="06 Learning Flywheel" id="flywheel">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="ft1" value="The learning flywheel — how Australis gets cleaner, better, cheaper" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="32" as="geometry" /></mxCell>
        <mxCell id="ft2" value="ADR-0002 · Everything right of &quot;capture&quot; is offline. If the entire learning subsystem is down, chat is unaffected — capture is a fire-and-forget queue write, never an inline dependency." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontStyle=2;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1600" height="20" as="geometry" /></mxCell>

        <mxCell id="fServe" value="1 · SERVE&#10;&#10;grounded, cited answer&#10;retrieval → compose → gate&#10;&#10;SLO untouched by any of this" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;verticalAlign=top;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="240" height="120" as="geometry" /></mxCell>
        <mxCell id="fCap" value="2 · CAPTURE&#10;&#10;async, fire-and-forget&#10;redacted BEFORE durable&#10;evidence REFERENCES, not bodies&#10;partitioned by tenant at write" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;verticalAlign=top;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="120" width="240" height="120" as="geometry" /></mxCell>
        <mxCell id="fSig" value="3 · SIGNALS  (out of band)&#10;&#10;expert review        1.0&#10;product outcome      0.9&#10;eval match           0.8&#10;human thumbs-up      0.4  ← low on purpose" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;verticalAlign=top;spacingTop=8;fontSize=11;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="660" y="120" width="300" height="120" as="geometry" /></mxCell>
        <mxCell id="fCorp" value="4 · CORPUS&#10;&#10;partition FIRST, then filter&#10;D3: independent signal required&#10;~3% of turns are SFT-eligible&#10;immutable, content-digested snapshots" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;verticalAlign=top;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="120" width="290" height="120" as="geometry" /></mxCell>
        <mxCell id="fTrain" value="5 · TRAIN&#10;&#10;LoRA, ~4 GPU-hours, &lt; $50&#10;base pinned, seed recorded&#10;reproducible from&#10;(base, snapshot digest, params)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;verticalAlign=top;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1370" y="120" width="270" height="120" as="geometry" /></mxCell>

        <mxCell id="fEval" value="6 · EVAL &amp; PROMOTION GATE&#10;&#10;offline eval  →  shadow 24h  →  canary 5% / 72h  →  promote&#10;&#10;ALL must hold vs the incumbent:&#10;   golden-set pass rate      ≥&#10;   citation coverage         no regression, floor 99%&#10;   refusal correctness       no regression&#10;   p99 TTFT                  ≤&#10;   cost per answer           ≤  (unless explicitly justified)&#10;&#10;No automatic promotion. A human records the decision with the eval diff,&#10;because the gates measure what the golden set contains and someone&#10;should look at what it does not.&#10;&#10;A model that answers better but cites worse is not better. It is more dangerous." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;align=left;spacing=10;verticalAlign=top;spacingTop=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="330" width="720" height="270" as="geometry" /></mxCell>

        <mxCell id="fe1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1" source="fServe" target="fCap"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1" source="fSig" target="fCorp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#9673a6;" edge="1" parent="1" source="fCap" target="fCorp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#9673a6;" edge="1" parent="1" source="fCorp" target="fTrain"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#9673a6;" edge="1" parent="1" source="fTrain" target="fEval"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe6" value="promoted adapter enters the tenant's model policy" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=3;strokeColor=#82b366;fontSize=11;fontColor=#3d6b2e;" edge="1" parent="1" source="fEval" target="fServe"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="fSafe" value="Why a bad adapter cannot do much damage&#10;&#10;Grounding is STRUCTURAL, not learned (D4). Retrieval, citation assembly,&#10;the confidence gate and refusal enforcement live in code and run AROUND&#10;the model, not inside it.&#10;&#10;So the worst a bad adapter does is phrase a grounded answer poorly, fail&#10;the gate more often, or cost more — all visible, all measured, all reversible&#10;by a config edit.&#10;&#10;It CANNOT invent a source. The source list is assembled before the model&#10;is called and validated after.&#10;&#10;&quot;The fine-tuned model learns not to hallucinate&quot; is a probability.&#10;PRD §5.1 asks for a guarantee. Rejected on sight." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=10;verticalAlign=top;spacingTop=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="460" height="290" as="geometry" /></mxCell>

        <mxCell id="fRisk" value="The failure mode this design exists to prevent&#10;&#10;Training on the model's own unlabelled output is model collapse with extra steps:&#10;quality degrades smoothly, every internal metric keeps looking fine because the metrics&#10;are self-referential, and users notice before you do.&#10;&#10;D3 is the guard: a turn enters the corpus ONLY if it carries a signal that did not come&#10;from the model. That is why the SFT-eligible fraction is ~3% and not ~90% — and that gap&#10;is a feature, not a data problem to be solved.&#10;&#10;Volume is not the constraint. One month of one live tenant already exceeds what a LoRA&#10;needs (13,500 examples/month vs 1,000–50,000 required). Cleanliness is the constraint." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacing=10;verticalAlign=top;spacingTop=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="660" width="1220" height="230" as="geometry" /></mxCell>

        <mxCell id="fTiers" value="Failure tiers&#10;&#10;capture queue      OPTIONAL&#10;corpus store       OPTIONAL&#10;training pipeline  OPTIONAL&#10;eval harness       OPTIONAL to serving,&#10;                   BLOCKING to promotion&#10;adapter endpoint   DEGRADABLE&#10;                   (router falls back)&#10;&#10;No critical tier, by construction." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacing=10;verticalAlign=top;spacingTop=10;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1320" y="330" width="320" height="290" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="07 Three Learning Tiers" id="tiers">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="tt1" value="Three learning tiers — what may be shared, and what may never be" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="32" as="geometry" /></mxCell>
        <mxCell id="tt2" value="ADR-0002 D1 · The load-bearing constraint: one weight set trained on Kora AND HMS data is an unrecoverable isolation failure. Weights cannot be un-mixed, cannot be deleted per user, and cannot satisfy an erasure request." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontStyle=2;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1600" height="20" as="geometry" /></mxCell>

        <mxCell id="T0" value="T0 · POLICY&#10;&#10;LEARNS   routing · tool selection · retrieval k&#10;         rerank weights · confidence thresholds&#10;&#10;FROM     metadata ONLY — which tool, latency, cost,&#10;         eval pass/fail, citation coverage.&#10;         No tenant content. Ever.&#10;&#10;ARTIFACT a config bundle. Numbers, not weights.&#10;&#10;SHARED   across ALL tenants&#10;HMS      participates — metadata carries no PHI&#10;FROM     Phase 4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=10;verticalAlign=top;spacingTop=10;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="500" height="300" as="geometry" /></mxCell>
        <mxCell id="T1" value="T1 · BEHAVIOUR&#10;&#10;LEARNS   answer format · citation discipline&#10;         refusal style · honest-escalation phrasing&#10;&#10;FROM     de-identified, consented traces&#10;         opt-in per tenant, default OFF&#10;&#10;ARTIFACT one LoRA adapter&#10;&#10;SHARED   among opt-in tenants only&#10;HMS      EXCLUDED — by construction and by test (I4)&#10;FROM     Phase 6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacing=10;verticalAlign=top;spacingTop=10;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="110" width="500" height="300" as="geometry" /></mxCell>
        <mxCell id="T2" value="T2 · DOMAIN&#10;&#10;LEARNS   tenant vocabulary · domain reasoning&#10;         product-specific grounding&#10;&#10;FROM     that ONE tenant's traces&#10;&#10;ARTIFACT one LoRA adapter per tenant&#10;&#10;SHARED   NEVER. Adapters do not merge, because&#10;         merging is the one operation that cannot&#10;         be undone.&#10;HMS      trained and served inside its own boundary&#10;FROM     Phase 5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacing=10;verticalAlign=top;spacingTop=10;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1120" y="110" width="520" height="300" as="geometry" /></mxCell>

        <mxCell id="stack" value="&quot;The Australis model&quot; for tenant X&#10;&#10;      Gemma-family base            ← rented, swappable, never forked&#10;   +  T1 behaviour adapter         ← shared, opt-in tenants&#10;   +  T2 &lt;tenant&gt; domain adapter   ← that tenant only&#10;   +  T0 policy config             ← numbers, not weights&#10;   ─────────────────────────────────────────────────────&#10;   =  the served model&#10;&#10;Australis owns the adapters, the corpus, the eval suites and the promotion history.&#10;It does not own, fork, or continue-pretrain a base — adapters port to a newer base in&#10;one retraining run, and a forked base is a permanent liability that buys nothing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=10;verticalAlign=top;spacingTop=10;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="800" height="270" as="geometry" /></mxCell>

        <mxCell id="t0note" value="T0 is the tier people underestimate&#10;&#10;It is a set of numbers, not a model. It shares no content, needs no consent,&#10;and is available a year or more before any adapter is worth training.&#10;&#10;A rerank weight tuned on mark8ly's catalog improving home-chef's recipes&#10;is real cross-product transfer at zero privacy cost.&#10;&#10;This is where &quot;Australis learns from all the products&quot; is literally true —&#10;and it is why it comes first in the plan." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=10;verticalAlign=top;spacingTop=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="450" width="760" height="200" as="geometry" /></mxCell>

        <mxCell id="inv" value="Isolation invariants — tested, not merely documented&#10;&#10;  I1  corpus builder cannot read across tenant partitions   ← protects the company&#10;  I2  a T2 adapter is served only to its own tenant&#10;  I3  T1 corpus excludes non-consenting tenants&#10;  I4  HMS traces never enter T1&#10;  I5  evidence bodies never persist to the corpus&#10;  I6  redaction runs before durability&#10;  I7  capture failure never fails a turn                     ← protects the SLO&#10;&#10;Partitioning is applied BEFORE filtering, so the dataset builder physically cannot emit a&#10;mixed-tenant dataset. D1 is enforced by the shape of the code, not by a check someone could remove." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacing=10;verticalAlign=top;spacingTop=10;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="880" y="670" width="760" height="230" as="geometry" /></mxCell>
        <mxCell id="eras" value="Erasure path — why adapters are retrained, never patched&#10;&#10;   delete traces  →  rebuild snapshot  →  retrain  →  promote&#10;&#10;An adapter records the digest of the snapshot it was trained on. That record is what&#10;makes a DPDP / GDPR erasure request tractable at the model layer at all." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=10;verticalAlign=top;spacingTop=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="800" height="150" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

</mxfile>
